{
  "_comment": "Source of truth for slacker shell completions. Two axes per command: selector (true => offers @repo/@_tag selectors when the word starts with @) and positional (the bare-word completion: installed | repo | template | repo:pkg | none). flags = extra subcommand-specific flags beyond the global set. Membership mirrors the completion arms in the merged hand-written bash. Regenerate outputs with: contrib/gen-completions.py",
  "_global_flags": ["--config-dir", "--yes", "-y", "--dry-run", "--no-deps", "--help", "-h", "--version", "-V"],
  "commands": {
    "update":            {"selector": false, "positional": "none"},
    "search":            {"selector": false, "positional": "none"},
    "file-search":       {"selector": false, "positional": "none"},
    "info":              {"selector": false, "positional": "installed"},
    "list-repos":        {"selector": false, "positional": "none"},
    "status":            {"selector": false, "positional": "none"},
    "install":           {"selector": true,  "positional": "none"},
    "upgrade":           {"selector": true,  "positional": "none"},
    "reinstall":         {"selector": true,  "positional": "installed"},
    "remove":            {"selector": true,  "positional": "installed"},
    "revert-pkg":        {"selector": false, "positional": "installed"},
    "download":          {"selector": true,  "positional": "none", "flags": ["-o", "--output"]},
    "upgrade-all":       {"selector": false, "positional": "none"},
    "upgrade-dist":      {"selector": false, "positional": "none"},
    "install-new":       {"selector": false, "positional": "repo"},
    "clean-system":      {"selector": false, "positional": "none"},
    "clean-cache":       {"selector": false, "positional": "repo"},
    "new-config":        {"selector": false, "positional": "none"},
    "check-updates":     {"selector": false, "positional": "none"},
    "show-changelog":    {"selector": false, "positional": "repo"},
    "history":           {"selector": false, "positional": "installed", "flags": ["--last", "--since", "--installed", "--removed", "--upgraded"]},
    "find-mirror":       {"selector": false, "positional": "none"},
    "generate-template": {"selector": false, "positional": "none"},
    "install-template":  {"selector": false, "positional": "template"},
    "remove-template":   {"selector": false, "positional": "template"},
    "delete-template":   {"selector": false, "positional": "template"},
    "frozen":            {"selector": false, "positional": "none"},
    "unfrozen":          {"selector": false, "positional": "none"},
    "pin":               {"selector": false, "positional": "repo:pkg"},
    "unpin":             {"selector": false, "positional": "installed"},
    "add-repo":          {"selector": false, "positional": "none"},
    "del-repo":          {"selector": false, "positional": "repo"},
    "pri-repo":          {"selector": false, "positional": "repo"},
    "add-tag":           {"selector": false, "positional": "none"},
    "del-tag":           {"selector": false, "positional": "none"},
    "vet-repo":          {"selector": false, "positional": "repo"},
    "trust-repo":        {"selector": false, "positional": "repo"},
    "distrust-repo":     {"selector": false, "positional": "repo"},
    "help":              {"selector": false, "positional": "none"}
  }
}
