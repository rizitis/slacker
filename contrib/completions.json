{
  "_comment": "Source of truth for slacker shell completions. arg is the positional-argument completion type: pkg | repo | template | selector | repo:pkg | none. selector = installed package names plus @repo/@_tag selectors. flags = extra subcommand-specific flags beyond the global set. Regenerate outputs with: contrib/gen-completions.py",
  "_global_flags": ["--config-dir", "--yes", "-y", "--dry-run", "--no-deps", "--help", "-h", "--version", "-V"],
  "commands": {
    "update":            {"arg": "none"},
    "search":            {"arg": "none"},
    "file-search":       {"arg": "none"},
    "info":              {"arg": "pkg"},
    "list-repos":        {"arg": "none"},
    "status":            {"arg": "none"},
    "install":           {"arg": "selector"},
    "upgrade":           {"arg": "selector"},
    "reinstall":         {"arg": "selector"},
    "remove":            {"arg": "selector"},
    "revert-pkg":        {"arg": "pkg"},
    "download":          {"arg": "selector", "flags": ["-o", "--output"]},
    "upgrade-all":       {"arg": "selector"},
    "upgrade-dist":      {"arg": "none"},
    "install-new":       {"arg": "selector"},
    "clean-system":      {"arg": "none"},
    "clean-cache":       {"arg": "repo"},
    "new-config":        {"arg": "none"},
    "check-updates":     {"arg": "none"},
    "show-changelog":    {"arg": "repo"},
    "history":           {"arg": "pkg", "flags": ["--last", "--since", "--installed", "--removed", "--upgraded"]},
    "find-mirror":       {"arg": "none"},
    "generate-template": {"arg": "none"},
    "install-template":  {"arg": "template"},
    "remove-template":   {"arg": "template"},
    "delete-template":   {"arg": "template"},
    "frozen":            {"arg": "none"},
    "unfrozen":          {"arg": "none"},
    "pin":               {"arg": "repo:pkg"},
    "unpin":             {"arg": "pkg"},
    "add-repo":          {"arg": "none"},
    "del-repo":          {"arg": "repo"},
    "pri-repo":          {"arg": "repo"},
    "add-tag":           {"arg": "none"},
    "del-tag":           {"arg": "none"},
    "vet-repo":          {"arg": "repo"},
    "trust-repo":        {"arg": "repo"},
    "distrust-repo":     {"arg": "repo"},
    "help":              {"arg": "none"}
  }
}
